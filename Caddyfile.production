# PRODUCTION - Custom Domain with Let's Encrypt SSL
school-sync.org, www.school-sync.org {
    tls kironotificatora@gmail.com
    
    handle_path /api/* {
        reverse_proxy backend-1:5000 backend-2:5000 backend-3:5000 {
            lb_policy round_robin
            health_uri /health
        }
    }
    
    handle {
        reverse_proxy frontend:80
    }
}

http://school-sync.org, http://www.school-sync.org {
    redir https://school-sync.org{uri} permanent
}