# PRODUCTION - Custom Domain with Let's Encrypt SSL
school-sync.org:444, www.school-sync.org:444 {
    tls kironotificatora@gmail.com
    
    handle_path /api/* {
        reverse_proxy backend-1:5000 backend-2:5000 backend-3:5000 {
            lb_policy round_robin
            health_uri /health
        }
    }
    
    handle {
        reverse_proxy frontend:80
    }
}

school-sync.org:81, www.school-sync.org:81 {
    redir https://school-sync.org:444{uri} permanent
}