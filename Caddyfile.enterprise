# ENTERPRISE - Main Frontend with Let's Encrypt SSL on port 443
assetflow.bg, www.assetflow.bg {
    tls kironotificatora@gmail.com
    
    handle_path /api/* {
        reverse_proxy backend-1:5000 backend-2:5000 backend-3:5000 {
            lb_policy round_robin
            health_uri /health
        }
    }
    
    handle {
        reverse_proxy frontend:80
    }
}

http://assetflow.bg, http://www.assetflow.bg {
    redir https://assetflow.bg{uri} permanent
}