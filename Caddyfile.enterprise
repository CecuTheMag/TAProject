# ENTERPRISE - Main Frontend with Let's Encrypt SSL on port 443
school-sync.org, www.school-sync.org {
    tls kironotificatora@gmail.com
    
    handle_path /admin-api/* {
        reverse_proxy admin_backend:5005 {
            header_up Host {upstream_hostport}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
    
    handle_path /api/* {
        reverse_proxy backend:5000 {
            header_up Host {upstream_hostport}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
    
    handle {
        reverse_proxy frontend:3000
    }
}

http://school-sync.org, http://www.school-sync.org {
    redir https://school-sync.org{uri} permanent
}